# Copy to .env and fill in. Never commit .env.

# --- Database (Postgres + pgvector) ---
POSTGRES_USER=gaitrag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gaitrag
POSTGRES_PORT=5432
# Used by the backend. Host "db" is the docker-compose service name.
DATABASE_URL=postgresql://gaitrag:change-me@db:5432/gaitrag

# --- Backend ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
# Optional: path to a different trained model bundle
# SPEED_MODEL_PATH=
MAX_UPLOAD_MB=10

# --- Retrieval models (used from M2/M3) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Reranker: small and fast by default; BAAI/bge-reranker-base is the larger option
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
# Retrieval: vector | bm25 | hybrid, reranking on/off (for ablations)
RETRIEVAL_MODE=hybrid
RERANK=true
TOP_K=8

# --- LLM provider (used from M4): "openai" or "huggingface" ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
HF_API_TOKEN=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
